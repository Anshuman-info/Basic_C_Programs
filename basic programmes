/**
 * Program: Array Min and Max
 * Description: Finds the smallest and largest values in an array.
 */
#include <stdio.h>

int main() {
    int size, i, max, min;
    
    printf("Enter number of elements in the array: \n");
    scanf("%d", &size);
    
    int arr[size];
    
    printf("Enter the elements: \n");
    for (i = 0; i < size; i++) {
        scanf("%d", &arr[i]);
    }
    
    min = arr[0];
    max = arr[0];
    
    for (i = 1; i < size; i++) {
        if (arr[i] < min) {
            min = arr[i];
        } else if (arr[i] > max) {
            max = arr[i];
        }
    }
    
    printf("\nThe min term = %d \nThe max term = %d\n", min, max);
    return 0;
}



/**
 * Program: Linear Search
 * Description: Searches for a specific value in an array and returns its position.
 */
#include <stdio.h>

int main() {
    int size, i, target, found = 0, position;
    
    printf("Enter number of elements in the array: \n");
    scanf("%d", &size);
    
    int arr[size];
    
    printf("Enter the elements: \n");
    for (i = 0; i < size; i++) {
        scanf("%d", &arr[i]);
    }
    
    printf("Enter the number to be found: \n");
    scanf("%d", &target);
    
    for (i = 0; i < size; i++) {
        if (arr[i] == target) {
            found = 1;
            position = i;
            break; // Stop searching once found
        }
    }
    
    if (found == 1) {
        printf("Number found at position arr[%d] = %d\n", position, arr[position]);
    } else {
        printf("Number not found\n");
    }
    
    return 0;
}



/**
 * Program: Reverse Array Output
 * Description: Reads an array and prints its elements in reverse order.
 */
#include <stdio.h>

int main() {
    int size, i;
    
    printf("Enter number of elements in the array: \n");
    scanf("%d", &size);
    
    int arr[size];
    
    printf("Enter the elements: \n");
    for (i = 0; i < size; i++) {
        scanf("%d", &arr[i]);
    }
    
    printf("\nReverse of the array is:\n");
    for (i = size - 1; i >= 0; i--) {
        printf("%d\n", arr[i]);
    }
    
    return 0;
}

