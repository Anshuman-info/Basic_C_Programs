/**
 * Program: Sum of Digits
 * Description: Calculates the sum of individual digits of a given integer.
 */
#include <stdio.h>

int main() {
    int number, sum = 0, remainder;
    
    printf("Enter a number: \n");
    scanf("%d", &number);
    
    while (number != 0) {
        remainder = number % 10;
        sum += remainder;
        number /= 10;
    }
    
    printf("Sum of digits = %d\n", sum);
    return 0;
}



/**
 * Program: Fibonacci Sequence
 * Description: Generates a Fibonacci sequence up to a specified number of terms.
 */
#include <stdio.h>

int main() {
    int first_term = 0, second_term = 1, next_term;
    int terms, i;
    
    printf("Enter the number of terms: \n");
    scanf("%d", &terms);
    
    printf("%d %d ", first_term, second_term);
    
    for (i = 1; i <= terms - 2; i++) {
        next_term = first_term + second_term;
        printf("%d ", next_term);
        
        first_term = second_term;
        second_term = next_term;
    }
    
    printf("\n");
    return 0;
}



/**
 * Program: Armstrong Number Checker
 * Description: Checks if a given number is an Armstrong number.
 */
#include <stdio.h>
#include <math.h>

int main() {
    int number, temp1, temp2;
    int digit_count = 0, sum = 0, remainder;
    
    printf("Enter a number: \n");
    scanf("%d", &number);
    
    temp1 = number;
    temp2 = number;
    
    // Count the number of digits
    while (temp1 != 0) {
        digit_count++;
        temp1 /= 10;
    }
    
    // Calculate the sum of digits powered by the digit count
    while (temp2 != 0) {
        remainder = temp2 % 10;
        sum += pow(remainder, digit_count);
        temp2 /= 10;
    }
    
    if (number == sum) {
        printf("Armstrong\n");
    } else {
        printf("Not Armstrong\n");
    }
    
    return 0;
}



/**
 * Program: Armstrong Numbers 1 to 500
 * Description: Finds and prints all Armstrong numbers between 1 and 500.
 */
#include <stdio.h>
#include <math.h>

int main() {
    int temp1, temp2;
    int digit_count, sum, remainder, i;
    
    printf("Armstrong numbers between 1 and 500:\n");
    
    for (i = 1; i <= 500; i++) {
        temp1 = i;
        temp2 = i;
        digit_count = 0;
        sum = 0;
        
        while (temp1 != 0) {
            digit_count++;
            temp1 /= 10;
        }
        
        while (temp2 != 0) {
            remainder = temp2 % 10;
            sum += pow(remainder, digit_count);
            temp2 /= 10;
        }
        
        if (i == sum) {
            printf("%d ", i);
        }
    }
    
    printf("\n");
    return 0;
}


/**
 * Program: Perfect Number Checker
 * Description: Checks if a number equals the sum of its proper divisors.
 */
#include <stdio.h>

int main() {
    int number, i, sum = 0;
    
    printf("Enter a number: \n");
    scanf("%d", &number);
    
    for (i = 1; i < number; i++) {
        if (number % i == 0) {
            sum += i;
        }
    }
    
    printf("Sum of factors = %d\n", sum);
    
    if (sum == number) {
        printf("Perfect number\n");
    } else {
        printf("Not a Perfect number\n");
    }
    
    return 0;
}



/**
 * Program: Greatest Common Divisor (GCD)
 * Description: Finds the highest number that divides two integers exactly.
 */
#include <stdio.h>

int main() {
    int num1, num2, i, gcd;
    
    printf("Enter two numbers: \n");
    scanf("%d %d", &num1, &num2);
    
    for (i = 1; i <= num1; i++) {
        if (num1 % i == 0 && num2 % i == 0) {
            gcd = i;
        }
    }
    
    printf("GCD = %d\n", gcd);
    return 0;
}


/**
 * Program: Maximum of Three Numbers
 * Description: Finds the largest of three inputs using nested ternary operators.
 */
#include <stdio.h>

int main() {
    int a, b, c, max;
    
    printf("Enter three numbers:\n");
    scanf("%d %d %d", &a, &b, &c);
    
    max = (a > b) ? ((a > c) ? a : c) : ((b > c) ? b : c);
    
    printf("Max term = %d\n", max);
    return 0;
}



